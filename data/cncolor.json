Zhū Zǐ Hè","hex":"#BEA89D","rgb":"190, 168, 157","category":"brown","term":"大寒"},{"id":379,"name":"鹰背褐","pinyin":"Yīng Bèi Hè","hex":"#8F6D5F","rgb":"143, 109, 95","category":"brown","term":"大寒"},{"id":380,"name":"麝香褐","pinyin":"Shè Xiāng Hè","hex":"#694B3C","rgb":"105, 75, 60","category":"brown","term":"大寒"},{"id":381,"name":"石英","pinyin":"Shí Yīng","hex":"#C8B6BB","rgb":"200, 182, 187","category":"white","term":"大寒"},{"id":382,"name":"银褐","pinyin":"Yín Hè","hex":"#9C8D9B","rgb":"156, 141, 155","category":"purple","term":"大寒"},{"id":383,"name":"烟红","pinyin":"Yān Hóng","hex":"#9D858F","rgb":"157, 133, 143","category":"red","term":"大寒"},{"id":384,"name":"紫诰","pinyin":"Zǐ Gào","hex":"#76555D","rgb":"118, 85, 93","category":"purple","term":"大寒"}],"terms":[{"id":"立春","name":"立春","poet":"东风解冻，蛰虫始振，鱼上冰。","source":"《礼记·月令》：立春之日，东风解冻。","story":"立春为二十四节气之首，象征春季开始。黄白游是立春的承色，取天地初交、万物萌发之意。"},{"id":"雨水","name":"雨水","poet":"随风潜入夜，润物细无声。","source":"杜甫《春夜喜雨》","story":"雨水是春季第二个节气，降雨开始增多。盈盈色取自春水盈盈之貌，是雨水节气的承色。"},{"id":"惊蛰","name":"惊蛰","poet":"微雨众卉新，一雷惊蛰始。","source":"韦应物《观田家》","story":"惊蛰是春季第三个节气，春雷始鸣，蛰伏的昆虫苏醒。桃夭色取自桃花初绽，是惊蛰节气的转色。"},{"id":"春分","name":"春分","poet":"春分雨脚落声微，柳岸斜风带客归。","source":"徐铉《春分》","story":"春分是昼夜平分之日。皦玉色取自洁白玉石的温润光泽，是春分节气的起色。"},{"id":"清明","name":"清明","poet":"清明时节雨纷纷，路上行人欲断魂。","source":"杜牧《清明》","story":"清明是气清景明之意。紫蒲色取自水边香蒲的深紫色，是清明节气的起色。"},{"id":"谷雨","name":"谷雨","poet":"谷雨如丝复似尘，煮瓶浮蜡正尝新。","source":"范成大《谷雨》","story":"谷雨是春季最后一个节气，雨生百谷。昌荣色是紫色的一种，取自仙草昌荣，是谷雨节气的起色。"},{"id":"立夏","name":"立夏","poet":"蝼蝈鸣，蚯蚓出，王瓜生。","source":"《礼记·月令》：立夏之日，蝼蝈鸣。","story":"立夏是夏季的开始，万物生长。青粲色取自麦粒初熟的绿色，是立夏节气的起色。"},{"id":"小满","name":"小满","poet":"苦菜秀，靡草死，小暑至。","source":"《礼记·月令》：小满之日，苦菜秀。","story":"小满时节，麦类灌浆但未完全饱满。彤管色取自红色管状植物，是小满节气的起色。"},{"id":"芒种","name":"芒种","poet":"螳螂生，鵙始鸣，反舌无声。","source":"《礼记·月令》：芒种之日，螳螂生。","story":"芒种是有芒的谷类作物可种之节。筠雾色取自竹间薄雾，是芒种节气的起色。"},{"id":"夏至","name":"夏至","poet":"昼晷已云极，宵漏自此长。","source":"韦应物《夏至避暑北池》","story":"夏至是北半球白昼最长之日。赩炽色取自赤红似火，是夏至节气的起色。"},{"id":"小暑","name":"小暑","poet":"温风至，蟋蟀居壁，鹰乃学习。","source":"《礼记·月令》：小暑之日，温风至。","story":"小暑标志着盛夏开始。骍刚色取自赤黄色的刚坚之气，是小暑节气的起色。"},{"id":"大暑","name":"大暑","poet":"赤日几时过，清风无处寻。","source":"曾几《大暑》","story":"大暑是一年中最热的节气。夕岚色取自傍晚山间的雾气，是大暑节气的起色。"},{"id":"立秋","name":"立秋","poet":"凉风至，白露降，寒蝉鸣。","source":"《礼记·月令》：立秋之日，凉风至。","story":"立秋是秋季的开始，暑去凉来。窃蓝色取自天空的淡蓝色，是立秋节气的起色。"},{"id":"处暑","name":"处暑","poet":"离离暑云散，袅袅凉风起。","source":"白居易《处暑》","story":"处暑意味着炎热离开。退红色取自浅红消退之色，是处暑节气的起色。"},{"id":"白露","name":"白露","poet":"鸿雁来，玄鸟归，群鸟养羞。","source":"《礼记·月令》：白露之日，鸿雁来。","story":"白露是寒气增长、露水凝结之节。凝脂色取自美人肌肤如玉，是白露节气的起色。"},{"id":"秋分","name":"秋分","poet":"漏钟仍夜浅，时节欲秋分。","source":"元稹《秋分》","story":"秋分是昼夜再次平分之日。卵色取自鸭蛋壳的淡绿色，是秋分节气的起色。"},{"id":"寒露","name":"寒露","poet":"萧疏桐叶上，月白露初团。","source":"戴察《寒露》","story":"寒露是寒气渐生、露水凝结之节。醽醁色取自美酒的淡绿色，是寒露节气的起色。"},{"id":"霜降","name":"霜降","poet":"豺乃祭兽，草木黄落，蛰虫咸俯。","source":"《礼记·月令》：霜降之日，豺乃祭兽。","story":"霜降是秋季最后一个节气，气温骤降。银朱色取自朱砂的赤红，是霜降节气的起色。"},{"id":"立冬","name":"立冬","poet":"水始冰，地始冻，雉入大水为蜃。","source":"《礼记·月令》：立冬之日，水始冰。","story":"立冬是冬季的开始。半见色取自隐约可见的浅黄色，是立冬节气的起色。"},{"id":"小雪","name":"小雪","poet":"虹藏不见，天气上腾，地气下降。","source":"《礼记·月令》：小雪之日，虹藏不见。","story":"小雪是冬季第二个节气，降水形式变为雪。龙膏烛色取自烛光的红粉色，是小雪节气的起色。"},{"id":"大雪","name":"大雪","poet":"大雪满初晨，开门万象新。","source":"薛能《大雪》","story":"大雪是仲冬开始，降雪增多。粉米色取自粉红色的稻米，是大雪节气的起色。"},{"id":"冬至","name":"冬至","poet":"蚯蚓结，麋角解，水泉动。","source":"《礼记·月令》：冬至之日，蚯蚓结。","story":"冬至是白昼最短之日。银红色取自银色的粉红，是冬至节气的起色。"},{"id":"小寒","name":"小寒","poet":"雁北乡，鹊始巢，雉始雊。","source":"《礼记·月令》：小寒之日，雁北乡。","story":"小寒是天气寒冷但未达极点。酂白色取自极浅的米白色，是小寒节气的起色。"},{"id":"大寒","name":"大寒","poet":"鸡使乳，鸷鸟厉疾，水泽腹坚。","source":"《礼记·月令》：大寒之日，鸡使乳。","story":"大寒是一年中最冷的节气。紫府色取自道教仙境的紫色，是大寒节气的起色。"}],"terms_date":[{"name":"小寒","month":1,"c":5.4055,"adj":{"2019":1}},{"name":"大寒","month":1,"c":20.12,"adj":{"2082":1}},{"name":"立春","month":2,"c":3.87},{"name":"雨水","month":2,"c":18.73,"adj":{"2026":-1}},{"name":"惊蛰","month":3,"c":5.63},{"name":"春分","month":3,"c":20.646},{"name":"清明","month":4,"c":4.81},{"name":"谷雨","month":4,"c":20.1},{"name":"立夏","month":5,"c":5.52},{"name":"小满","month":5,"c":21